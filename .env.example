
# Configuración de ejemplo para Kotoduo
# Completar los valores en el archivo .env local.
# Nunca subir credenciales reales a GitHub.

DEBUG=1
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Base de datos MySQL
DB_NAME=kotoduo
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Configuración opcional
NUM_PROXIES=1
SSL_REDIRECT=1
HSTS_SECONDS=0
SESSION_HORAS=12
LOG_LEVEL=INFO
CACHE_DIR=/var/cache/kotoduo
